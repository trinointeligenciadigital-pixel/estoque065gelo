# Estoque 065 — modelo de variáveis de ambiente.
# Copie para .env.local e preencha. NÃO versione o .env.local.

# --- Convex (frontend) ---
# Preenchido automaticamente por `npx convex dev` na primeira execução.
VITE_CONVEX_URL=

# --- Clerk (frontend) ---
# Painel do Clerk > API Keys > Publishable key (começa com pk_test_ ou pk_live_).
VITE_CLERK_PUBLISHABLE_KEY=

# Observação: o CONVEX_DEPLOYMENT também é gravado aqui pelo `convex dev`.
# O domínio do issuer do Clerk NÃO fica no frontend — é setado no Convex com:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://SEU-DOMINIO.clerk.accounts.dev
