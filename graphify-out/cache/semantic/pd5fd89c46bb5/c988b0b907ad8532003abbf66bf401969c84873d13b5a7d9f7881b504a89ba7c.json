{"nodes": [{"id": "design_design_system", "label": "Design System: Estoque 065", "file_type": "document", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_livro_razao_vivo", "label": "North Star: O livro-raz\u00e3o vivo", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registro sempre atualizado e audit\u00e1vel; cada n\u00famero \u00e9 rastre\u00e1vel at\u00e9 a movimenta\u00e7\u00e3o que o originou. A confian\u00e7a vem da precis\u00e3o, n\u00e3o do enfeite. Paleta derivada do gelo (o produto), n\u00e3o do interior escuro da c\u00e2mara fria."}, {"id": "design_regra_voz_unica", "label": "A Regra da Voz \u00danica", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ciano-petr\u00f3leo #0e7c9c \u00e9 s\u00f3 a\u00e7\u00e3o, nunca decora\u00e7\u00e3o; sua raridade \u00e9 o que faz significar 'aja aqui'."}, {"id": "design_regra_sinal_junto_cor", "label": "A Regra do Sinal Junto da Cor", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entrada/sa\u00edda/diverg\u00eancia/alerta nunca dependem s\u00f3 de cor (verde/vermelho/\u00e2mbar); sempre acompanham sinal (+/\u2212), texto ou seta \u2014 para daltonismo e luz forte."}, {"id": "design_regra_numero_em_mono", "label": "A Regra do N\u00famero em Mono", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Todo n\u00famero exibido (peso, saldo, quantidade, PIN, hora, placa, diverg\u00eancia) \u00e9 IBM Plex Mono; texto \u00e9 Inter. Faz colunas alinharem como um raz\u00e3o cont\u00e1bil."}, {"id": "design_regra_rotulo_mostrador", "label": "A Regra do R\u00f3tulo-Mostrador", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R\u00f3tulos de estrutura s\u00e3o Plex Mono em versalete com tracking, emoldurando o dado como texto ao redor de um mostrador."}, {"id": "design_regra_sem_sombra", "label": "A Regra do Sem-Sombra", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sistema plano por princ\u00edpio; profundidade por borda 1px, camada tonal e espa\u00e7o. \u00danico escurecimento permitido \u00e9 o v\u00e9u do modal. Sombra difusa cinza \u00e9 cara de app de 2014."}, {"id": "design_regua_de_nivel", "label": "R\u00e9gua de n\u00edvel (componente-assinatura)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Barra de saldo por produto proporcional ao peso; vira vermelho abaixo do m\u00ednimo. Tradu\u00e7\u00e3o literal do North Star \u2014 o n\u00edvel do estoque lido como um mostrador."}, {"id": "design_tabela", "label": "Tabela do Admin (componente-assinatura)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_dois_modos_densidade", "label": "Dois modos de densidade numa s\u00f3 identidade", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Colaborador arejado (toque 56px) / Admin denso; necessidades opostas atendidas sem trocar de identidade."}], "edges": [{"source": "design_regua_de_nivel", "target": "design_livro_raz